MARKET_DATA_PROVIDER=yfinance
FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true uses paper trading; false selects the live brokerage endpoint.
ALPACA_PAPER=true
MARKET_STREAM_ENABLED=false
EXECUTION_ENABLED=false
STOP_MANAGEMENT_ENABLED=false
ALPACA_DATA_FEED=iex
POSTGRES_DSN=postgresql://kube_trader:change-me@localhost:5432/kube_trader
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me
DATABASE_PATH=/data/market.db
DEFAULT_SYMBOLS=AAPL,MSFT,SPY
MAX_TRADE_RISK_PCT=0.01
DAILY_DRAWDOWN_LIMIT_PCT=0.03
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
INTRADAY_ALLOCATION_PCT=0.20
SWING_ALLOCATION_PCT=0.30
CORE_ALLOCATION_PCT=0.50
SIGNAL_FAST_BARS=5
SIGNAL_SLOW_BARS=20
SWING_ATR_PERIOD=14
SWING_ATR_MULTIPLE=2.0
CORE_STOP_LOSS_PCT=0.20
RECONCILE_INTERVAL_SECONDS=30
MAX_SIGNAL_AGE_SECONDS=180
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO

