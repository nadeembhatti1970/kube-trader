MARKET_DATA_PROVIDER=yfinance
APP_VERSION=dev
FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true uses paper trading; false selects the live brokerage endpoint.
ALPACA_PAPER=true
MARKET_STREAM_ENABLED=false
EXECUTION_ENABLED=false
NEW_ENTRIES_ENABLED=false
STOP_MANAGEMENT_ENABLED=false
ALPACA_DATA_FEED=iex
# PostgreSQL role/database identifiers use underscores; Kubernetes service names use hyphens.
# This host is for the default Helm release; use "postgres" with the raw k8s manifests.
POSTGRES_DSN=postgresql://kube_trader:change-me@kube-trader-postgres:5432/kube_trader
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me
DATABASE_PATH=/data/market.db
ETF_HOLDINGS_SYMBOL=SPY
ETF_HOLDINGS_URL=https://www.ssga.com/library-content/products/fund-data/etfs/us/holdings-daily-us-en-spy.xlsx
ETF_MAX_HOLDINGS=100
UNIVERSE_REFRESH_SECONDS=86400
UNIVERSE_SCREEN_ENABLED=true
MIN_SYMBOL_PRICE=5
MIN_AVG_DOLLAR_VOLUME=20000000
MAX_WATCHLIST_SYMBOLS=40
# Add custom classifications as SYMBOL:sector pairs separated by commas.
SYMBOL_SECTORS=
MAX_OPEN_POSITIONS=20
MAX_SYMBOL_EXPOSURE_PCT=0.05
EXTENDED_HOURS_SAMPLING_ENABLED=true
EXTENDED_HOURS_SAMPLE_SECONDS=300
INTRADAY_FLATTEN_MINUTES=10
INTRADAY_ENTRY_CUTOFF_MINUTES=30
# Skip intraday entries this many minutes after the open; early bars are unreliable.
INTRADAY_ENTRY_START_MINUTES=5
# Halt new intraday entries for the session once realized pool loss reaches this share of equity.
INTRADAY_DAILY_LOSS_LIMIT_PCT=0.005
SYMBOL_LOSS_COOLDOWN_SECONDS=1800
SYMBOL_DAILY_LOSS_LIMIT=50
# Cap burst entries: at most this many new orders in any rolling five minutes; 0 disables.
MAX_ENTRIES_PER_5MIN=3
MAX_SECTOR_EXPOSURE_PCT=0.25
MAX_TRADE_RISK_PCT=0.01
# Cap total open stop-risk across managed positions; 0 disables.
MAX_PORTFOLIO_OPEN_RISK_PCT=0.02
DAILY_DRAWDOWN_LIMIT_PCT=0.03
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
INTRADAY_ALLOCATION_PCT=0.20
SWING_ALLOCATION_PCT=0.30
CORE_ALLOCATION_PCT=0.50
SIGNAL_FAST_BARS=5
SIGNAL_SLOW_BARS=20
SIGNAL_MIN_SPREAD_PCT=0.001
SIGNAL_MIN_BUY_RSI=55
SWING_ATR_PERIOD=14
SWING_ATR_MULTIPLE=2.0
CORE_STOP_LOSS_PCT=0.20
BACKTEST_COST_BPS=5
BACKTEST_TRAIN_FRACTION=0.70
INTRADAY_BACKTEST_BARS=50000
RECONCILE_INTERVAL_SECONDS=30
ALPACA_ACTIVITY_SYNC_SECONDS=300
ALPACA_ACTIVITY_LOOKBACK_DAYS=30
MAX_SIGNAL_AGE_SECONDS=180
EXECUTION_LATENCY_WARN_SECONDS=30
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
